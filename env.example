# ============================================================
# Podcast Studio – Konfiguration
# ============================================================
# Kopiere diese Datei zu ".env" und passe die Werte an.
# Die .env-Datei NIEMALS ins Git einchecken!

# ----------------------------------------------------------
# Admin-Passwort (bcrypt-Hash)
# ----------------------------------------------------------
# Hash erzeugen:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('DEIN_PASSWORT'))"
# Das Ergebnis ($2b$12$...) hier eintragen:
ADMIN_PASSWORD_HASH=

# ----------------------------------------------------------
# Session-Secret (mindestens 32 zufaellige Zeichen)
# ----------------------------------------------------------
# Zufallswert erzeugen:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ----------------------------------------------------------
# Session-Laufzeit in Stunden (Standard: 12)
# ----------------------------------------------------------
SESSION_MAX_AGE_HOURS=12
