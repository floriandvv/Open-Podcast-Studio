# Existing persistent data directory; required. Never point an upgrade at empty data.
DATA_DIR=/srv/open-podcast-data
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_HOST_PASSWORD=change-this-host-password
# Set only when already managed externally. Otherwise retain DATA_DIR/session_secret.
# SESSION_SECRET=
STUDIO_PRODUCTION=1
STUDIO_ALLOWED_ORIGINS=https://podcast.example.org

# Initial defaults only. Later changes are made in Admin.
JITSI_MODE=off
JITSI_PUBLIC_URL=https://meet.jit.si

# Self-hosted mode only. Install the bundled lifecycle module on Prosody MUC.
# All providers use external_api.js and Jitsi prejoin; no local native SDK is used.
# JITSI_DOMAIN=meet.example.org
# JITSI_APP_ID=openpodcast
# JITSI_APP_SECRET=
# JITSI_CONTROL_KEY=
# JITSI_CONTROL_URL=https://meet.example.org/openpodcast/close

# Jitsi as a Service (JaaS / 8x8): security configuration, server-side only.
# The non-secret App ID and deployment mode are configured in the Admin panel.
# Full API key ID from the JaaS console: <App ID>/<Key ID>.
# JAAS_API_KEY_ID=
# Recommended: store the RSA private key outside the web/application directory.
# JAAS_PRIVATE_KEY_FILE=/run/secrets/jaas-private-key.pem
# Alternatively JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Use exactly ONE private-key source, never both. RSA >= 2048 bits.
# Token lifetime in seconds (30..300); never longer than the call deadline.
JAAS_TOKEN_TTL_SECONDS=120
# Restart the server after changes to security configuration. Never commit real keys.

# Optional MAU API adapter. Fill ONLY from endpoint/auth/schema confirmed by 8x8.
# No public MAU endpoint is assumed. Blank => use signed webhook observations.
# URL must be HTTPS on 8x8.vc / 8x8.com (or their subdomains), without redirects.
# Optional literal {app_id} is replaced by the public App ID configured in Admin.
# The dedicated API access credential belongs ONLY in .env; never in Admin.
JAAS_USAGE_API_URL=
JAAS_USAGE_API_BEARER=
# Dot-separated JSON object paths from the confirmed response schema.
# Count must be an integer >= 0; period must identify the provider billing period.
JAAS_USAGE_MAU_PATH=
JAAS_USAGE_PERIOD_PATH=

# JaaS console -> Webhooks -> Reveal secret (NOT the JaaS API key).
# Subscribe USAGE and ROOM_DESTROYED to https://YOUR-STUDIO/api/jitsi/webhook.
JAAS_WEBHOOK_SECRET=
# Optional previous endpoint secret during rotation; leave empty otherwise.
JAAS_WEBHOOK_PREVIOUS_SECRET=
JAAS_WEBHOOK_TOLERANCE_SECONDS=300
