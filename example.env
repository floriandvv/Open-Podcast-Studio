# Required: create this directory first; keep it persistent and outside the public web root.
DATA_DIR=/srv/open-podcast-data

# Initial passwords only. Use different strong values; later password changes are stored in auth.json.
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_HOST_PASSWORD=change-this-host-password

# Optional session settings. If SESSION_SECRET is blank, it is generated in DATA_DIR on first start.
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12

# For production, enable the origin check and list the exact HTTPS origin(s) serving Open Podcast.
STUDIO_PRODUCTION=0
STUDIO_ALLOWED_ORIGINS=https://podcast.example.org

# Optional Jitsi defaults; provider settings can also be managed in Admin.
JITSI_MODE=off
JITSI_PUBLIC_URL=https://meet.jit.si
JITSI_DOMAIN=
JITSI_APP_ID=openpodcast
JITSI_APP_SECRET=
JITSI_CONTROL_KEY=
JITSI_CONTROL_URL=

# Optional JaaS (8x8). Keep the private key on the server; set either key file or inline PEM, not both.
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_FILE=
# JAAS_PRIVATE_KEY=
JAAS_TOKEN_TTL_SECONDS=120
JAAS_WEBHOOK_SECRET=
JAAS_WEBHOOK_PREVIOUS_SECRET=
JAAS_WEBHOOK_TOLERANCE_SECONDS=300

# Optional JaaS usage API; fill only when your account provides these endpoints.
JAAS_USAGE_API_URL=
JAAS_USAGE_API_BEARER=
JAAS_USAGE_MAU_PATH=
JAAS_USAGE_PERIOD_PATH=

# Optional MiroTalk SFU REST integration. MIROTALK_URL must match the origin saved in Admin.
MIROTALK_URL=
MIROTALK_API_KEY=
MIROTALK_USERNAME=
MIROTALK_PASSWORD=
